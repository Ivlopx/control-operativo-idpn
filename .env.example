# HTTPS through your reverse proxy. Use false only for local HTTP testing.
IDPN_COOKIE_SECURE=true
IDPN_BIND_ADDRESS=127.0.0.1
IDPN_PORT=5001
IDPN_ADMIN_USERNAME=admin
# Optional initial password (at least 12 characters).
# If omitted, a random password is saved in /data/config/auth/initial-admin.txt.
IDPN_ADMIN_PASSWORD=
# Set to the actual Docker network used by Nginx Proxy Manager.
IDPN_PROXY_NETWORK=infraestructura_default
